# ── Express enquiry API (server/index.js) ──────────────────────────────
PORT=8787

# Comma-separated list of origins allowed to POST enquiries.
# Required in production; the server refuses to start without it.
SITE_ORIGIN=http://localhost:3001

# Secret for the inbox endpoints (GET /api/enquiries, PATCH /api/enquiries/:id).
# Send it as the "x-admin-token" header. Unset = inbox disabled.
ADMIN_TOKEN=

# Where the SQLite file lives. Created on first write.
SQLITE_PATH=server/data/enquiries.db

# Set when the API runs behind a proxy (Render, Railway, nginx) so req.ip
# is the visitor's real address instead of the proxy's.
# TRUST_PROXY=1

# ── Optional email notification ────────────────────────────────────────
# Leave MAIL_TO empty to skip email and only store enquiries.
# MAIL_TO=studio@example.com
# MAIL_FROM="Anisha Tely Films <no-reply@example.com>"
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# ...or, without a connection string:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Next.js frontend ───────────────────────────────────────────────────
# Public URL of the enquiry API, including its protocol and host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
